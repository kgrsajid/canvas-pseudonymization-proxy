# --- Upstream Canvas instance (REQUIRED) ---
UPSTREAM_URL=http://canvas.example.internal
# Canvas API token held ONLY by this proxy. Minimal scopes: users, courses,
# enrollments, submissions (read), conversations (write).
CANVAS_API_TOKEN=

# --- Pseudonymization key (REQUIRED). Generate on-site, never share. ---
# HMAC_KEY=b64:$(openssl rand -base64 48)   <- recommended workflow
HMAC_KEY=

# --- Vault backend (exactly one REQUIRED) ---
# Production: institution PostgreSQL
# DATABASE_URL=postgresql://proxy:secret@localhost:5432/canvas_proxy_vault
# Dev/demo: SQLite file. NOTE: inside Docker the CWD is /srv/app, so a relative
# path like ./data/vault.db would land OUTSIDE the mounted volume. Use the
# absolute compose path:
# VAULT_SQLITE=/srv/data/vault.db
VAULT_SQLITE=/srv/data/vault.db

# --- Security layers (§8) ---
# mTLS: CA bundle for client certificates. If set, TLS terminator must verify
# client certs and forward X-SSL-Client-Verify / X-SSL-Client-S-DN headers.
# MTLS_CLIENT_CA=/etc/canvas-proxy/client-ca.pem
# Optional: restrict to one client-cert CN
# ALLOWED_PEER=<app-name>
# Optional HMAC request signing: X-Proxy-Auth: HMAC:<ts>.<hex>
# AUTH_HMAC_SECRET=
# AUTH_REPLAY_WINDOW_S=60
# Optional IP allowlist (comma-separated)
# ALLOWED_IPS=
# DEV-ONLY escape hatch: allow startup with NO auth layer configured (the
# proxy refuses to start unauthenticated without this). Never set in production.
# DEV_ALLOW_NO_AUTH=true

# --- Behaviour ---
# NAMELESS_MODE=0

# --- Tunables (defaults = design-doc values) ---
# RESOLVE_RATE_LIMIT_PER_MIN=30
# RESOLVE_DISPLAY_TTL_S=60
# UPSTREAM_RATE_LIMIT_PER_MIN=300
# UPSTREAM_TIMEOUT_S=30
# UPSTREAM_CONNECT_TIMEOUT_S=10
# UPSTREAM_MAX_RETRIES=2
